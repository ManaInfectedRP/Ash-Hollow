{
  "name": "souls-platformer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sprites": "node tools/sprites/build.mjs",
    "atlas": "python -I tools/atlas/extract_atlas.py",
    "icons": "node tools/icons/build-icons.mjs",
    "android": "npm run build && npx cap sync android",
    "qr": "node tools/qr/make-qr.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
